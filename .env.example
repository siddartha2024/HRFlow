# ── DuckDB warehouse ───────────────────────────────────────────────────────────
DUCKDB_PATH=./data/warehouse.duckdb

# ── Ollama — local LLM (Stage 9) ───────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Data generation settings (Stages 2-3) ─────────────────────────────────────
NUM_EMPLOYEES=5000
SEED_YEARS_BACK=3

# ── Airflow / Docker (Stage 8) ─────────────────────────────────────────────────
# Run: echo "AIRFLOW_UID=$(id -u)" to get your value
AIRFLOW_UID=50000
